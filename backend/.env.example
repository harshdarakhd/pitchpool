# Local without Docker (default):
DATABASE_URL=sqlite+aiosqlite:///./pitchpool.db
REDIS_URL=memory://

# With Docker / production Postgres + Redis:
# DATABASE_URL=postgresql+asyncpg://pitchpool:pitchpool@localhost:5432/pitchpool
# REDIS_URL=redis://localhost:6379/0

SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CRICHEROES_TOURNAMENT_ID=1691351
CRICHEROES_BASE_URL=https://cricheroes.com/tournament/1691351/maheshwari-tennis-premier-league-season-4-2026
ENVIRONMENT=development

# Required in production (use independent random values):
CRON_SECRET=change-me-use-openssl-rand-hex-32
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Render runs one scheduler in the API process while the service is awake.
ENABLE_INPROCESS_SCHEDULER=true
SYNC_STALE_MINUTES=10
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true
